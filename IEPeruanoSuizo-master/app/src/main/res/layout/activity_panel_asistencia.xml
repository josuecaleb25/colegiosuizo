<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <FrameLayout
        android:id="@+id/camera_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_scanner_overlay"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="30dp"
        android:background="@drawable/bg_glass_back"
        android:contentDescription="Salir sin finalizar la asistencia"
        android:padding="17dp"
        android:scaleType="centerInside"
        android:src="@drawable/icon_arrow_google"
        app:tint="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_session_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:background="@drawable/bg_glass_action_circle"
        android:fontFamily="@font/poppinsmedium"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:text="Sesión activa"
        android:textColor="#E3E3E3"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/scanner_viewfinder"
        android:layout_width="336dp"
        android:layout_height="343dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_scanner_corner" />
        <View
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="top|end"
            android:rotation="90"
            android:background="@drawable/bg_scanner_corner" />
        <View
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="bottom|start"
            android:rotation="270"
            android:background="@drawable/bg_scanner_corner" />
        <View
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="bottom|end"
            android:rotation="180"
            android:background="@drawable/bg_scanner_corner" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/scanner_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="28dp"
        android:baselineAligned="false"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/scanner_actions_bar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2.25"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:background="@drawable/bg_glass_actions">

            <ImageButton
                android:id="@+id/btn_flash"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_glass_action_circle"
                android:contentDescription="Activar o desactivar flash"
                android:padding="14dp"
                android:scaleType="centerInside"
                android:src="@drawable/icon_flashlight_google" />

            <View
                android:layout_width="1dp"
                android:layout_height="32dp"
                android:layout_marginHorizontal="12dp"
                android:background="#1FFFFFFF" />

            <ImageButton
                android:id="@+id/btn_switch_camera"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_glass_action_circle"
                android:contentDescription="Cambiar cámara"
                android:padding="14dp"
                android:scaleType="centerInside"
                android:src="@drawable/icon_flip_camera_google" />

            <View
                android:layout_width="1dp"
                android:layout_height="32dp"
                android:layout_marginHorizontal="12dp"
                android:background="#1FFFFFFF" />

            <ImageButton
                android:id="@+id/btn_culminar_asistencia"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_glass_action_circle"
                android:contentDescription="Finalizar asistencia"
                android:padding="14dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_finish_figma" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/scanner_counter_bar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/bg_glass_counter">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/icon_id_card_google"
                android:contentDescription="Alumnos registrados" />

            <TextView
                android:id="@+id/tv_contador_asistencia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppinsmedium"
                android:text="0 alum."
                android:textColor="#E3E3E3"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/legacy_compatibility_views"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_activar_camara"
            android:layout_width="1dp"
            android:layout_height="1dp" />
        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/autoComplete_salon"
            android:layout_width="1dp"
            android:layout_height="1dp" />
        <EditText android:id="@+id/et_buscador" android:layout_width="1dp" android:layout_height="1dp" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_alumnos" android:layout_width="1dp" android:layout_height="1dp" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_alumnos_search" android:layout_width="1dp" android:layout_height="1dp" />
        <View android:id="@+id/layout_empty_state" android:layout_width="1dp" android:layout_height="1dp" />
        <View android:id="@+id/layout_paginacion" android:layout_width="1dp" android:layout_height="1dp" />
        <View android:id="@+id/divider_paginacion" android:layout_width="1dp" android:layout_height="1dp" />
        <TextView android:id="@+id/tv_pagination_info" android:layout_width="1dp" android:layout_height="1dp" />
        <ImageButton android:id="@+id/btn_page_prev" android:layout_width="1dp" android:layout_height="1dp" />
        <ImageButton android:id="@+id/btn_page_next" android:layout_width="1dp" android:layout_height="1dp" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
